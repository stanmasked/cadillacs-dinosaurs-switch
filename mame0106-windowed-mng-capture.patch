 static performance_info performance;
 
 /* movie file */
 static mame_file *movie_file = NULL;
 static int movie_frame = 0;
+static int movie_frames_written = 0;
+int mng_capture_start_frame = 0;
+int mng_capture_frame_count = 0;
 
 /* misc other statics */
 static UINT32 leds_status;
@@ -1030,6 +1033,7 @@
 
 	movie_frame = 0;
+	movie_frames_written = 0;
 }
 
 
@@ -1064,13 +1068,25 @@
 void record_movie_frame(mame_bitmap *bitmap)
 {
 	if (movie_file != NULL && bitmap != NULL)
 	{
+		int current_frame = movie_frame++;
+
+		/* Keep playback running, but write only the requested frame window. */
+		if (current_frame < mng_capture_start_frame)
+			return;
+		if (mng_capture_frame_count > 0 &&
+			movie_frames_written >= mng_capture_frame_count)
+		{
+			record_movie_stop();
+			return;
+		}
+
 		profiler_mark(PROFILER_MOVIE_REC);
 
-		if (movie_frame++ == 0)
+		if (movie_frames_written++ == 0)
 			save_frame_with(movie_file, bitmap, mng_capture_start);
 		save_frame_with(movie_file, bitmap, mng_capture_frame);
 
+		if (mng_capture_frame_count > 0 &&
+			movie_frames_written >= mng_capture_frame_count)
+			record_movie_stop();
+
 		profiler_mark(PROFILER_END);
 	}
 }
